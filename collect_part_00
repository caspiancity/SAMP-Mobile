47: // Masinin oz handling kopyasini qaytarir (yoxdursa yaradir). Ugursuzdursa 0.
48: static uintptr_t GetOrCreateOwnHandling(void* pVeh)
49: {
50:     if (!pVeh) return 0;
51: 
52:     uintptr_t* pSlot = GetHandlingSlot(pVeh);
53:     uintptr_t pCurrent = *pSlot;
54:     if (!pCurrent) return 0;
55: 
56:     auto it = g_VehicleHandlings.find((uintptr_t)pVeh);
57:     if (it != g_VehicleHandlings.end())
58:     {
59:         // artiq oz kopyasi var ve masin hele de ondan istifade edir
60:         if (it->second.pOwn == pCurrent)
61:             return pCurrent;
62: 
63:         // oyun pointeri deyismisdir (masin yeniden yaradilib ve s.) -> kohne kopyani at
64:         free((void*)it->second.pOwn);
65:         g_VehicleHandlings.erase(it);
66:     }
67: 
68:     uintptr_t pNew = (uintptr_t)malloc(HND_SIZE);
69:     if (!pNew) return 0;
70: 
71:     memcpy((void*)pNew, (void*)pCurrent, HND_SIZE);
72: 
73:     HandlingEntry entry;
74:     entry.pOriginal = pCurrent;
75:     entry.pOwn = pNew;
76:     g_VehicleHandlings[(uintptr_t)pVeh] = entry;
77: 
78:     *pSlot = pNew;
79:     return pNew;
80: }
