107:     void ApplyHandling(CVehicleGTA* veh, Entry& e)
108:     {
109:         VehicleTuning& t = e.tune;
110:         t.speedPct = Clamp(t.speedPct,  50.0f, 250.0f);
111:         t.accelPct = Clamp(t.accelPct,  30.0f, 300.0f);
112:         t.brakePct = Clamp(t.brakePct,  30.0f, 300.0f);
113:         t.steerPct = Clamp(t.steerPct,  50.0f, 150.0f);
114:         t.massPct  = Clamp(t.massPct,   30.0f, 300.0f);
115:         if (t.headlight >= HEADLIGHT_COLOR_COUNT) t.headlight = 0;
116: 
117:         if (IsNeutral(t))
118:         {
119:             RestoreHandling(veh, e);
120:             return;
121:         }
122: 
123:         if (!e.copy)
124:         {
125:             if (!veh->m_pHandlingData) return;
126:             e.orig     = veh->m_pHandlingData;
127:             e.baseMass = veh->m_fMass;
128:             e.copy     = new tHandlingData(*e.orig);
129:         }
130:         veh->m_pHandlingData = e.copy;      // ferdi kopyaya bagla
131: 
132:         const float kSpd = t.speedPct * 0.01f;
133:         const float kAcc = t.accelPct * 0.01f;
134:         const float kBrk = t.brakePct * 0.01f;
135:         const float kStr = t.steerPct * 0.01f;
136:         const float kMas = t.massPct  * 0.01f;
137: 
138:         // Her zaman ORIGINAL-dan hesablayiriq -> tekrar tetbiq edende yigilmir (idempotent).
139:         const cTransmission& to = e.orig->m_transmissionData;
140:         cTransmission&       tc = e.copy->m_transmissionData;
141: 
142:         tc.m_fMaxVelocity           = to.m_fMaxVelocity        * kSpd;
143:         tc.m_fMaxGearVelocity       = to.m_fMaxGearVelocity    * kSpd;
144:         tc.m_maxReverseGearVelocity = to.m_maxReverseGearVelocity;
145:         tc.m_fEngineAcceleration    = to.m_fEngineAcceleration * kAcc;
146: 
147:         // Vites cedveli: her tTransmissionGear-in butun sahələri suretdir -> hamisini miqyasla.
148:         constexpr size_t kFloatsPerGear = sizeof(tTransmissionGear) / sizeof(float);
149:         for (int i = 0; i < 6; ++i)
150:         {
151:             const float* src = reinterpret_cast<const float*>(&to.m_aGears[i]);
152:             float*       dst = reinterpret_cast<float*>(&tc.m_aGears[i]);
153:             for (size_t j = 0; j < kFloatsPerGear; ++j) dst[j] = src[j] * kSpd;
154:         }
155: 
156:         HND_BRAKE(e.copy) = HND_BRAKE(e.orig) * kBrk;
157:         HND_STEER(e.copy) = HND_STEER(e.orig) * kStr;
158:         HND_MASS(e.copy)  = HND_MASS(e.orig)  * kMas;
159:         e.copy->m_fMassRecpr = e.orig->m_fMassRecpr / kMas;   // 1/kutle ayrica saxlanir
160:         e.copy->m_fTurnMass  = e.orig->m_fTurnMass  * kMas;   // firlanma ataletı kutle ile birge artmali
161: 
162:         // Fizika kutlesi handling-den AYRI saxlanir -> onu da yenile.
163:         veh->m_fMass = e.baseMass * kMas;
164:     }
