98:     void RestoreHandling(CVehicleGTA* veh, Entry& e)
99:     {
100:         if (!e.copy) return;
101:         if (veh->m_pHandlingData == e.copy) veh->m_pHandlingData = e.orig;   // ƏVVƏL pointeri qaytar
102:         veh->m_fMass = e.baseMass;
103:         delete e.copy;                                                       // SONRA sil
104:         e.copy = nullptr;
105:     }
