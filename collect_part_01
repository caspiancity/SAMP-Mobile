269: bool ImGuiWrapper::createFontTexture()
270: {
271: 	Log::traceLastFunc("ImGuiWrapper::createFontTexture");
272: 
273: 	ImGuiIO& io = ImGui::GetIO();
274: 	unsigned char* pxs;
275: 	int width, height, bytes_per_pixel;
276: 	io.Fonts->GetTexDataAsRGBA32(&pxs, &width, &height, &bytes_per_pixel);
277: 
278: 	RwImage* font_img = RwImageCreate(width, height, bytes_per_pixel * 8);
279: 	RwImageAllocatePixels(font_img);
280: 
281: 	if (font_img == nullptr)
282: 	{
283: 		Log::addParameter("Font image pointer", font_img);
284: 		return false;
285: 	}
286: 
287: 	RwUInt8* pixels = font_img->cpPixels;
288: 	for (int y = 0; y < font_img->height; y++)
289: 	{
290: 		memcpy((void*)pixels, pxs + font_img->stride * y, font_img->stride);
291: 		pixels += font_img->stride;
292: 	}
293: 
294: 	RwInt32 w, h, d, flags;
295: 	RwImageFindRasterFormat(font_img, rwRASTERTYPETEXTURE, &w, &h, &d, &flags);
296: 	m_fontRaster = RwRasterCreate(w, h, d, flags);
297: 	if (m_fontRaster == nullptr)
298: 	{
299: 		Log::addParameter("font raster pointer", m_fontRaster);
300: 		return false;
301: 	}
302: 
303: 	m_fontRaster = RwRasterSetFromImage(m_fontRaster, font_img);
304: 	io.Fonts->TexID = (ImTextureID*)m_fontRaster;
305: 
306: 	RwImageDestroy(font_img);
307: 
308: 	Log::addParameter("Atlas width", width);
309: 	Log::addParameter("Atlas height", height);
310: 	return true;
311: 
312: }
