170: bool ProcessClientCommands(const std::string& input)
171: {
172:         if (input.empty() || input[0] != '/') return false;
173: 
174:         std::stringstream ss(input);
175:         std::string cmd;
176:         ss >> cmd;
177: 
178:         std::transform(cmd.begin(), cmd.end(), cmd.begin(), ::tolower);
179: 
180:         // ===== Lua =====
181:         if (cmd == "/luareload") {
182:                 bool ok = LuaManager::Init();
183:                 pUI->chat()->addDebugMessage(ok ? "{00FF00}[Lua]: yuklendi" : "{FF0000}[Lua]: xeta");
184:                 return true;
185:         }
186: 
187:         {
188:                 std::string luaArgs;
189:                 std::getline(ss, luaArgs);
190:                 size_t lp = luaArgs.find_first_not_of(" \t");
191:                 luaArgs = (lp == std::string::npos) ? "" : luaArgs.substr(lp);
192: 
193:                 if (LuaManager::OnCommand(cmd, luaArgs)) return true;
194: 
195:                 // stream-i basa qaytar ki, asagidaki C++ komandalari duzgun isleye
196:                 ss.clear();
